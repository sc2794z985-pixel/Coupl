{
  "expo": {
    "name": "Coupl",
    "slug": "coupl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "coupl",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coupl.app"
    },
    "android": {
      "package": "com.coupl.app",
      "adaptiveIcon": {
        "backgroundColor": "#C9B8FF",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "splash": {
      "backgroundColor": "#FAFAF8"
    }
  }
}
